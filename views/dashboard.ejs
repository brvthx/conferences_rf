<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
</head>
<body>
  <h1><%= title %></h1>
  <p>Пользователь: <b><%= user.fio %></b></p>

  <h2>Мои заявки</h2>
  <ul>
    <% requests.forEach(function (r) { %>
      <li><%= r.room_name %> — <i><%= r.status %></i></li>
    <% }); %>
  </ul>

  <p><a href="/">← На главную</a></p>
</body>
</html>